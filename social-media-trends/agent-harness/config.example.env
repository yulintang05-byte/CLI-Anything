# ─────────────────────────────────────────────────────────────
# Social Media Trends CLI — API Keys Configuration
# Copy this file to .env and fill in your keys.
# Load with: export $(cat .env | xargs)
# ─────────────────────────────────────────────────────────────

# YouTube Data API v3 (REQUIRED for youtube commands)
# Get yours: https://console.cloud.google.com/
#   1. Create project → Enable "YouTube Data API v3"
#   2. APIs & Services → Credentials → Create API Key
#   Free tier: 10,000 units/day (trending fetch ≈ 100 units)
YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok Research API (OPTIONAL — enhances tiktok videos command)
# Get yours: https://developers.tiktok.com/products/research-api/
#   Requires: approved developer account (apply takes 1-2 weeks)
#   tiktok hashtags/songs/creators use Creative Center (NO KEY NEEDED)
TIKTOK_RESEARCH_TOKEN=your_tiktok_research_token_here

# ─────────────────────────────────────────────────────────────
# COMMANDS THAT WORK WITHOUT ANY API KEY:
#   social-trends tiktok hashtags
#   social-trends tiktok songs
#   social-trends tiktok creators
#   social-trends theme *  (all theme page commands)
#   social-trends account bio
#   social-trends account schedule
# ─────────────────────────────────────────────────────────────
